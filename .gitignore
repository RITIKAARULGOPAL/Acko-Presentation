# Local Claude Code permissions
.claude/settings.local.json

# Python caches
__pycache__/

# deck inventory and slide exports from tools/acko (regenerated from the PPTX)
tools/_media/

# the inputs Ritika drops in: the layout DXF (very large) and the source renders; the presentation uses converted copies
inputs/

# intermediates of the DXF pipeline
tools/_work/

# puppeteer-core for tools/walk.js and tools/raster_plan.js
node_modules/

# built from slides/ by tools/build.py (tools/serve.py rebuilds it on every page load)
index.html

# exported versions for the meeting (folder + zip)
versions/

# the joined single file and one-slide previews (tools/build.py --single / --only)
dist/
preview.html

# one worktree per slide (python tools/worktrees.py add): each is its own checkout, never part of this one
.claude/worktrees/
